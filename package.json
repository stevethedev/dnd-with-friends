{
  "name": "dnd-with-friends",
  "version": "0.1.0",
  "description": "Desktop app hosting D&D Beyond and Roll20 with Beyond20 integration",
  "repository": "https://github.com/stevenmjimenez/dnd-with-friends",
  "main": "./out/main/index.mjs",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prebuild": "npm-run-all clean icons",
    "check": "npm-run-all check:*",
    "check:types": "npm run typecheck",
    "check:format": "prettier --check .",
    "check:lint": "eslint --max-warnings=0 .",
    "check:deps": "knip",
    "fix": "npm-run-all fix:*",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "icons": "icon-gen -i ./resources/icon.png -o ./resources/icons --ico --ico-name=icon --icns --icns-name icon --favicon --favicon-name icon --favicon-png-sizes 16,32,128,256,512,1024",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:win": "npm run package -- --win",
    "package:mac": "npm run package -- --mac",
    "package:linux": "npm run package --linux",
    "typecheck": "npm-run-all typecheck:*",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "clean": "node -e \"require('fs').rmSync('out', {recursive:true,force:true})\""
  },
  "keywords": [],
  "author": "stevenmjimenez@gmail.com",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-store": "^11.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "icon-gen": "^5.0.0",
    "knip": "^6.12.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.3"
  }
}
